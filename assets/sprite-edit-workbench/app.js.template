const asset='/assets/aatba/age10_ninja_gaiden/star_tide_battle_character_sprites_v1/enemies/ch03_red_seal_clamp_shell/';
const names={'idle-left':'待机','march-left':'行走',guard:'格挡','shield-bash':'盾击','guard-break':'破防／恢复',hurt:'受击',defeat:'退场'};
const $=s=>document.querySelector(s),ctx=$('canvas').getContext('2d');ctx.imageSmoothingEnabled=false;
let state={entries:[],binding:{actions:{}}},tab='work',action='shield-bash',candidate=null,manuallySelected=false,index=0,playing=true,last=0,old={},oldActions=[],atlas=new Image(),current=null,loadedAtlas='';
function button(text,fn){const b=document.createElement('button');b.textContent=text;b.onclick=fn;return b}
async function refresh(){const r=await fetch('/boss-api/state',{cache:'no-store'});if(!r.ok)throw Error('工作台服务不可用');state=await r.json();$('#budget').textContent=`生成预算（含保守预留） ${state.budget.reserved_seconds||0} / 80 秒`;render()}
function options(){let list=state.entries.filter(e=>e.action===action);if(tab==='confirmed')list=list.filter(e=>e.confirmed);if(tab==='game')list=list.filter(e=>state.binding.actions[action]?.candidate===e.id);return list}
function render(){
 document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));
 $('#actions').replaceChildren(...Object.entries(names).map(([id,name])=>{const n=state.entries.filter(e=>e.action===id).length;const b=button(name+(n?` · ${n}`:''),()=>{action=id;candidate=null;manuallySelected=false;index=0;render()});b.classList.toggle('active',action===id);return b}));
 const list=options();current=(manuallySelected?list.find(e=>e.id===candidate):null)||list.filter(e=>!e.rejected).at(-1)||list.at(-1)||null;candidate=current?.id||null;
 $('#title').textContent=names[action];$('#candidates').replaceChildren(...list.map(e=>{const b=button(e.candidate+(e.rejected?' · 已退回':e.confirmed?' · 已确认':' · 待审核'),()=>{candidate=e.id;manuallySelected=true;index=0;render()});b.classList.toggle('active',current?.id===e.id);return b}));
 const src=current?current.atlas:asset+'atlas.png';if(loadedAtlas!==src){loadedAtlas=src;atlas=new Image();atlas.onload=draw;atlas.src=src}
 const v=$('#video');v.hidden=!current;if(current&&v.getAttribute('src')!==current.preview){v.src=current.preview;v.play().catch(()=>{})}
 $('#status').textContent=current?(tab==='game'?'已绑定到城堡·改；重新进入第一关 Boss 房生效。':current.confirmed?'已确认此候选；可单独绑定到游戏。':current.rejected?'该候选有明确质量问题，仅保留对照。':'H3 新版候选 · 可播放、逐帧检查、调整帧范围，然后确认与绑定。'):(tab==='confirmed'?'尚无已确认的 H3 动作，以下为旧版对照。':tab==='game'?'此动作仍使用旧版游戏素材。':'此动作尚未完成 H3 处理，以下为旧版对照。');
 $('#detail').textContent=current?`${current.count} 帧 · ${current.fps.toFixed(2)} FPS · 检查：${current.qc.status}。${current.qc.issues.map(i=>({libtv_visual_watermark_review_required:'请直接检查画面中无内嵌水印',foreground_touches_edge:'部分帧前景触边',audio_near_clipping:'生成音频峰值偏高；游戏继续使用现有音效'}[i.code]||i.code)).join('；')}`:`旧版 ${oldActions.find(a=>a.name===action)?.frames||0} 帧。`;
 editing();filmstrip();draw()
}
function editing(){const e=$('#editing');e.replaceChildren();e.hidden=!current;if(!current)return;
 e.style.flexWrap='wrap';const c=current,s=c.selection||{start:0,end:c.count-1,fps:c.fps,loop:['idle-left','march-left'].includes(action),impact:Math.min(40,c.count-1),active_end:Math.min(44,c.count-1)};
 for(const [id,label,value] of [['start','首帧',s.start],['end','末帧',s.end],['fps','FPS',s.fps],...(action==='shield-bash'?[['impact','命中首帧',s.impact],['active_end','命中末帧',s.active_end]]:[])]){const l=document.createElement('label');l.textContent=label+' ';const input=document.createElement('input');input.id='edit-'+id;input.type='number';input.value=value;input.min=id==='fps'?1:0;input.max=id==='fps'?120:c.count-1;input.style.width='75px';l.append(input);e.append(l)}
 const label=document.createElement('label'),loop=document.createElement('input');loop.id='edit-loop';loop.type='checkbox';loop.checked=s.loop;loop.style.width='auto';label.append(loop,' 循环');e.append(label);
 e.append(button('用当前帧作首帧',()=>$('#edit-start').value=index),button('用当前帧作末帧',()=>$('#edit-end').value=index));
 e.append(button('确认此动作（含流畅度与无水印）',async()=>{await post('confirm',{id:c.id,start:+$('#edit-start').value,end:+$('#edit-end').value,fps:+$('#edit-fps').value,loop:$('#edit-loop').checked,impact:+($('#edit-impact')?.value||0),active_end:+($('#edit-active_end')?.value||0)})}));
 if(c.confirmed)e.append(button('绑定到城堡·改',()=>{const now={start:+$('#edit-start').value,end:+$('#edit-end').value,fps:+$('#edit-fps').value,loop:$('#edit-loop').checked,impact:+($('#edit-impact')?.value||0),active_end:+($('#edit-active_end')?.value||0)};if(Object.entries(now).some(([k,v])=>v!==c.selection[k])){$('#message').textContent='片段已调整，请先确认新片段。';return}return post('bind',{id:c.id})}));
 if(state.binding.actions[action])e.append(button('恢复旧版绑定',()=>post('unbind',{action})));
}
async function post(op,payload){try{const r=await fetch('/boss-api/'+op,{method:'POST',headers:{'Content-Type':'application/json','X-Boss-Token':state.token},body:JSON.stringify(payload)});const v=await r.json();if(!r.ok)throw Error(v.error);$('#message').textContent=op==='bind'?'绑定已保存；重新进入第一关 Boss 房生效。':'已保存';await refresh()}catch(e){$('#message').textContent=e.message}}
function filmstrip(){const list=current?current.frames:old[action];if(!list)return;const size=current?384:192,ratio=96/size;const cols=current?8:8,rows=current?Math.ceil(current.count/8):7;$('#filmstrip').replaceChildren(...list.map((f,i)=>{const b=button(String(i+1),()=>{index=i;step(0)});b.title=`第 ${i+1} 帧`;b.dataset.frame=i;b.style.cssText=`width:96px;height:96px;padding:0;padding-top:74px;background-image:url("${loadedAtlas}");background-repeat:no-repeat;background-size:${cols*96}px ${rows*96}px;background-position:${-f.x*ratio}px ${-f.y*ratio}px;font-size:11px`;return b}))}
function draw(){const frames=current?current.frames:old[action];if(!frames?.length)return;index=(index+frames.length)%frames.length;const f=frames[index],w=f.width??f.w,h=f.height??f.h;ctx.clearRect(0,0,576,576);if(atlas.complete&&atlas.naturalWidth)ctx.drawImage(atlas,f.x,f.y,w,h,0,0,576,576);$('#frame').textContent=`第 ${index+1} 帧 / 共 ${frames.length} 帧（索引 ${index}）`;document.querySelectorAll('[data-frame]').forEach(b=>b.style.borderColor=+b.dataset.frame===index?'#ffcd70':'#526684')}
function step(d){playing=false;$('#play').textContent='播放';index+=d;draw()}
function tick(t){const fps=Number($('#edit-fps')?.value)||current?.fps||oldActions.find(a=>a.name===action)?.fps||12;const start=Number($('#edit-start')?.value)||0;const end=Number($('#edit-end')?.value??((current?.count||old[action]?.length||1)-1));if(playing&&t-last>=1000/fps/+$('#speed').value){last=t;index++;if(index>end||index<start)index=start;draw()}requestAnimationFrame(tick)}
document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;candidate=null;manuallySelected=false;index=0;render()});$('#prev').onclick=()=>step(-1);$('#next').onclick=()=>step(1);$('#play').onclick=e=>{playing=!playing;e.target.textContent=playing?'暂停':'播放'};document.addEventListener('keydown',e=>{if(['INPUT','SELECT'].includes(e.target.tagName))return;if(['ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();step(e.key==='ArrowLeft'?-1:1)}});
Promise.all([fetch(asset+'character-manifest.json').then(r=>r.json()),fetch(asset+'atlas.json').then(r=>r.json())]).then(async([m,a])=>{oldActions=m.actions;for(const[k,v]of Object.entries(a.frames))(old[k.split('/')[0]]??=[]).push(v.frame);await refresh();requestAnimationFrame(tick)}).catch(e=>$('#status').textContent=e.message);
setInterval(async()=>{if(!document.activeElement?.id.startsWith('edit-')){try{const r=await fetch('/boss-api/state',{cache:'no-store'});const next=await r.json();if(JSON.stringify(next.entries.map(e=>[e.id,e.confirmed]))!==JSON.stringify(state.entries.map(e=>[e.id,e.confirmed]))){state=next;render()}$('#budget').textContent=`生成预算（含保守预留） ${next.budget.reserved_seconds||0} / 80 秒`}catch{}}},10000);
